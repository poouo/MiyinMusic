<Window
    x:Class="MiYin.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MiYin.Desktop.Models"
    mc:Ignorable="d"
    Title="觅音">

    <Grid x:Name="Root" Background="{StaticResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Padding="16,0,150,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Image Source="Assets/app.png" Width="28" Height="28" />
                <TextBlock Text="觅音" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource TitleBarButtonStyle}" Margin="18,0,12,0"
                    Click="Back_Click" IsEnabled="False" ToolTipService.ToolTip="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="15" />
            </Button>

            <AutoSuggestBox x:Name="GlobalSearch" Grid.Column="2" Height="32" VerticalAlignment="Center"
                            PlaceholderText="搜索歌曲、歌手、歌单" QuerySubmitted="GlobalSearch_QuerySubmitted"
                            BorderBrush="{StaticResource LineBrush}" Background="{StaticResource CardBrush}" CornerRadius="16" />

        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="10,10,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="MainNav" Spacing="2">
                        <Button x:Name="NavHome" Style="{StaticResource NavButtonStyle}" Tag="home" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontSize="17" /><TextBlock Text="发现" /></StackPanel>
                        </Button>
                        <Button x:Name="NavCharts" Style="{StaticResource NavButtonStyle}" Tag="charts" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9D2;" FontSize="17" /><TextBlock Text="排行榜" /></StackPanel>
                        </Button>
                        <Button x:Name="NavSquare" Style="{StaticResource NavButtonStyle}" Tag="square" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8FD;" FontSize="17" /><TextBlock Text="歌单广场" /></StackPanel>
                        </Button>
                        <Button x:Name="NavSearch" Style="{StaticResource NavButtonStyle}" Tag="search" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE721;" FontSize="17" /><TextBlock Text="搜索" /></StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Tag="settings" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="17" /><TextBlock Text="设置" /></StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="我的音乐" Style="{StaticResource SectionLabelStyle}" />

                    <StackPanel x:Name="LibraryNav" Grid.Row="2" Spacing="2">
                        <Button x:Name="NavLiked" Style="{StaticResource NavButtonStyle}" Tag="liked" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xEB51;" FontSize="16" /><TextBlock Text="我的喜欢" /></StackPanel>
                        </Button>
                        <Button x:Name="NavRecent" Style="{StaticResource NavButtonStyle}" Tag="recent" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE823;" FontSize="16" /><TextBlock Text="最近播放" /></StackPanel>
                        </Button>
                        <Button x:Name="NavDownloads" Style="{StaticResource NavButtonStyle}" Tag="downloads" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE896;" FontSize="16" /><TextBlock Text="下载管理" /></StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="12,14,4,5">
                        <TextBlock Text="我的歌单" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" CharacterSpacing="60" />
                        <Button x:Name="AddPlaylistButton" HorizontalAlignment="Right" Style="{StaticResource FlatIconButtonStyle}" Width="24" Height="24" Click="AddPlaylist_Click" ToolTipService.ToolTip="新建歌单">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                        </Button>
                    </Grid>

                    <ListView x:Name="SidebarPlaylists" Grid.Row="4" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="SidebarPlaylist_ItemClick" ItemContainerStyle="{StaticResource SidebarItemStyle}"
                              Background="Transparent" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34" Padding="10,0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}"
                                               Margin="9,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button x:Name="UserButton" Grid.Row="5" Style="{StaticResource NavButtonStyle}" Height="56"
                            Click="UserButton_Click" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Left">
                                <TextBlock x:Name="UserInitial" Text="♪" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="1">
                                <TextBlock x:Name="UserName" Text="登录 / 注册" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="UserRole" Text="同步歌单与收藏" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Frame x:Name="ContentFrame" Grid.Column="1" Background="Transparent" Navigated="ContentFrame_Navigated" />
        </Grid>

        <!-- ================= 播放条 ================= -->
        <Border Grid.Row="2" Background="{StaticResource PlayerBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="16,9,16,12" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- 当前歌曲 -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="54" Height="54" RadiusX="10" RadiusY="10" VerticalAlignment="Center"
                               Fill="{Binding Player.CoverUrl, Converter={StaticResource CoverBrush}}"
                               Tapped="PlayerInfo_Tapped" ToolTipService.ToolTip="展开歌词"
                               AutomationProperties.Name="展开歌词" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,8,0" Spacing="2"
                                Tapped="PlayerInfo_Tapped" ToolTipService.ToolTip="展开歌词">
                        <TextBlock Text="{Binding Player.Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Player.Singer}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Player.ErrorMessage}" FontSize="10" Foreground="{StaticResource PinkBrush}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Player.ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PlayerIconButtonStyle}" Click="PlayerFavorite_Click" ToolTipService.ToolTip="喜欢">
                        <FontIcon x:Name="PlayerHeartIcon" Glyph="&#xEB51;" FontSize="15" />
                    </Button>
                </Grid>

                <!-- 控制与进度 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" VerticalAlignment="Center">
                        <Button x:Name="ShuffleButton" Style="{StaticResource PlayerIconButtonStyle}" Click="Shuffle_Click" ToolTipService.ToolTip="随机播放">
                            <FontIcon Glyph="&#xE8B1;" FontSize="15" Foreground="{Binding Player.Shuffle, Converter={StaticResource BoolToActiveBrush}}" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Prev_Click" ToolTipService.ToolTip="上一首">
                            <FontIcon Glyph="&#xE892;" FontSize="18" />
                        </Button>
                        <Button x:Name="PlayerPlayButton" AutomationProperties.AutomationId="PlayerPlayButton" AutomationProperties.Name="播放/暂停"
                                Style="{StaticResource PlayCircleButtonStyle}" Click="PlayPause_Click" ToolTipService.ToolTip="播放/暂停">
                            <FontIcon Glyph="{Binding Player.PlayGlyph}" FontSize="18" Foreground="#06130C" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Next_Click" ToolTipService.ToolTip="下一首">
                            <FontIcon Glyph="&#xE893;" FontSize="18" />
                        </Button>
                        <Button x:Name="RepeatButton" Style="{StaticResource PlayerIconButtonStyle}" Click="Repeat_Click"
                                ToolTipService.ToolTip="{Binding Player.RepeatText}" AutomationProperties.Name="播放模式">
                            <FontIcon Glyph="{Binding Player.RepeatGlyph}" FontSize="15" Foreground="{Binding Player.RepeatActive, Converter={StaticResource BoolToActiveBrush}}" />
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="8" VerticalAlignment="Center" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Player.PositionText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="ProgressSlider" Grid.Column="1" Height="28" Minimum="0" Maximum="1" StepFrequency="0.01"
                                ValueChanged="ProgressSlider_ValueChanged" IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- 右侧操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="LyricsButton" AutomationProperties.AutomationId="LyricsButton" AutomationProperties.Name="歌词"
                            Style="{StaticResource GhostButtonStyle}" Height="28" Padding="10,0" Click="FullPlayer_Click" ToolTipService.ToolTip="歌词 / 全屏播放">
                        <TextBlock Text="词" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="QualityButton" Style="{StaticResource GhostButtonStyle}" Height="28" Padding="10,0" Click="Quality_Click" ToolTipService.ToolTip="选择音质">
                        <TextBlock Text="{Binding Player.QualityLabel}" FontSize="11" />
                    </Button>
                    <Button x:Name="QueueButton" Style="{StaticResource PlayerIconButtonStyle}" Click="Queue_Click" ToolTipService.ToolTip="播放队列">
                        <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                    </Button>
                    <Button x:Name="MuteButton" Style="{StaticResource PlayerIconButtonStyle}" Click="ToggleMute_Click" ToolTipService.ToolTip="静音">
                        <FontIcon Glyph="{Binding Player.VolumeGlyph}" FontSize="16" />
                    </Button>
                    <Slider x:Name="VolumeSlider" Width="86" Height="26" Minimum="0" Maximum="1" StepFrequency="0.01"
                            ValueChanged="VolumeSlider_ValueChanged" IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 全屏播放 ================= -->
        <Grid x:Name="NowPlayingOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#FF07090F">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="3" Fill="{Binding Player.CoverUrl, Converter={StaticResource CoverBrush}}" Opacity="0.22" Stretch="UniformToFill" />
            <Rectangle Grid.RowSpan="3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D907090F" Offset="0" />
                        <GradientStop Color="#B807090F" Offset="0.55" />
                        <GradientStop Color="#FF07090F" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Grid.Row="0" Padding="38,28,28,0">
                <TextBlock Text="正在播放" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" CharacterSpacing="160" VerticalAlignment="Center" />
                <Button x:Name="CloseNowPlayingButton" Style="{StaticResource FlatIconButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="CloseNowPlaying_Click" ToolTipService.ToolTip="收起">
                    <FontIcon Glyph="&#xE711;" FontSize="17" Foreground="{StaticResource TextBrush}" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Padding="64,18,64,8" ColumnSpacing="64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="22">
                    <Grid Width="340" Height="340">
                        <Ellipse Width="326" Height="326" Fill="#FF101521" Opacity="0.8" />
                        <Border CornerRadius="26" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Rectangle RadiusX="26" RadiusY="26" Fill="{Binding Player.CoverUrl, Converter={StaticResource CoverBrush}}" />
                        </Border>
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Player.Title}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Player.Singer}" FontSize="14" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="{Binding Player.AlbumName}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                            </Border>
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="{Binding Player.QualityLabel}" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" MaxWidth="620" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,2">
                        <TextBlock Text="歌词" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="点击任意一句可跳转" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView Grid.Row="1" x:Name="LyricsList" Background="Transparent" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="Lyric_ItemClick" ItemContainerStyle="{StaticResource LyricItemStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden" Padding="0,70,0,110">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="2,7" Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacity}}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Text}" FontSize="{Binding IsActive, Converter={StaticResource LyricFontSize}}"
                                                   FontWeight="{Binding IsActive, Converter={StaticResource LyricWeight}}"
                                                   Foreground="{Binding IsActive, Converter={StaticResource LyricBrush}}" TextWrapping="Wrap" LineHeight="25" />
                                        <TextBlock Text="{Binding Translation}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding Translation, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoLyricsText" Text="暂无歌词，安静享受音乐吧" FontSize="14" Foreground="{StaticResource TextFaintBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2" Padding="64,8,64,28" Spacing="10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Player.PositionText}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Slider x:Name="FullProgressSlider" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01"
                            ValueChanged="FullProgressSlider_ValueChanged" IsThumbToolTipEnabled="False" />
                    <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
                    <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Shuffle_Click"><FontIcon Glyph="&#xE8B1;" FontSize="16" Foreground="{Binding Player.Shuffle, Converter={StaticResource BoolToActiveBrush}}" /></Button>
                    <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Prev_Click"><FontIcon Glyph="&#xE892;" FontSize="21" /></Button>
                    <Button x:Name="FullPlayButton" AutomationProperties.AutomationId="FullPlayButton" AutomationProperties.Name="播放/暂停"
                            Style="{StaticResource PlayCircleButtonStyle}" Width="52" Height="52" Click="PlayPause_Click">
                        <FontIcon Glyph="{Binding Player.PlayGlyph}" FontSize="22" Foreground="#06130C" />
                    </Button>
                    <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Next_Click"><FontIcon Glyph="&#xE893;" FontSize="21" /></Button>
                    <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Repeat_Click" ToolTipService.ToolTip="{Binding Player.RepeatText}"><FontIcon Glyph="{Binding Player.RepeatGlyph}" FontSize="16" Foreground="{Binding Player.RepeatActive, Converter={StaticResource BoolToActiveBrush}}" /></Button>
                    <Button Style="{StaticResource PlayerIconButtonStyle}" Click="PlayerFavorite_Click"><FontIcon Glyph="&#xEB51;" FontSize="16" /></Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= 播放队列 ================= -->
        <Grid x:Name="QueueOverlay" Grid.Row="1" Visibility="Collapsed">
            <Rectangle Fill="#66000000" />
            <Border Width="400" HorizontalAlignment="Right" Background="{StaticResource PlayerBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid Padding="16,14,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="播放队列" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="QueueCountText" Text="" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" Height="26" Padding="9,0" Click="QueueClear_Click">
                                <TextBlock Text="清空" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource FlatIconButtonStyle}" Width="26" Height="26" Click="CloseQueue_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="QueueEmptyText" Grid.Row="1" Text="播放队列是空的" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Queue_ItemClick"
                              ItemContainerStyle="{StaticResource PlainListViewItemStyle}" Background="Transparent" Padding="0,8,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="50" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SingerText}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource FlatIconButtonStyle}" Width="26" Height="26" Click="QueueRemove_Click" ToolTipService.ToolTip="移出队列">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 提示 ================= -->
        <Grid Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,56,0,0" IsHitTestVisible="False">
            <InfoBar x:Name="ToastBar" IsOpen="False" Severity="Informational" MinWidth="300" MaxWidth="520" />
        </Grid>
    </Grid>
</Window>
