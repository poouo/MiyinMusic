<Window
    x:Class="MiYin.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MiYin.Desktop.Models"
    mc:Ignorable="d"
    Title="觅音">

    <Grid x:Name="Root" Background="{ThemeResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="104" />
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Padding="16,0,150,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Image Source="Assets/app.png" Width="28" Height="28" />
                <TextBlock Text="觅音" FontSize="14.5" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource TitleBarButtonStyle}" Margin="18,0,12,0"
                    Click="Back_Click" IsEnabled="False" ToolTipService.ToolTip="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="15" />
            </Button>

            <AutoSuggestBox x:Name="GlobalSearch" Grid.Column="2" Height="32" VerticalAlignment="Center"
                            PlaceholderText="搜索歌曲、歌手、歌单" QuerySubmitted="GlobalSearch_QuerySubmitted"
                            BorderBrush="{ThemeResource LineBrush}" Background="{ThemeResource CardBrush}" CornerRadius="16" />

        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Border Grid.Column="0" Background="{ThemeResource SidebarBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="10,10,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="MainNav" Spacing="2">
                        <Button x:Name="NavHome" Style="{StaticResource NavButtonStyle}" Tag="home" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;" FontSize="17" /><TextBlock Text="发现" /></StackPanel>
                        </Button>
                        <Button x:Name="NavCharts" Style="{StaticResource NavButtonStyle}" Tag="charts" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE9D2;" FontSize="17" /><TextBlock Text="排行榜" /></StackPanel>
                        </Button>
                        <Button x:Name="NavSquare" Style="{StaticResource NavButtonStyle}" Tag="square" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8FD;" FontSize="17" /><TextBlock Text="歌单广场" /></StackPanel>
                        </Button>
                        <Button x:Name="NavSearch" Style="{StaticResource NavButtonStyle}" Tag="search" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE721;" FontSize="17" /><TextBlock Text="搜索" /></StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Tag="settings" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="17" /><TextBlock Text="设置" /></StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="LibrarySectionLabel" Grid.Row="1" Text="我的音乐" Style="{StaticResource SectionLabelStyle}" />

                    <StackPanel x:Name="LibraryNav" Grid.Row="2" Spacing="2">
                        <Button x:Name="NavLiked" Style="{StaticResource NavButtonStyle}" Tag="liked" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xEB51;" FontSize="16" /><TextBlock Text="我的喜欢" /></StackPanel>
                        </Button>
                        <Button x:Name="NavRecent" Style="{StaticResource NavButtonStyle}" Tag="recent" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE823;" FontSize="16" /><TextBlock Text="最近播放" /></StackPanel>
                        </Button>
                        <Button x:Name="NavDownloads" Style="{StaticResource NavButtonStyle}" Tag="downloads" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE896;" FontSize="16" /><TextBlock Text="下载管理" /></StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="PlaylistSectionHeader" Grid.Row="3" Margin="12,14,4,5">
                        <TextBlock Text="我的歌单" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" CharacterSpacing="60" />
                        <Button x:Name="AddPlaylistButton" HorizontalAlignment="Right" Style="{StaticResource FlatIconButtonStyle}" Width="24" Height="24" Click="AddPlaylist_Click" ToolTipService.ToolTip="新建歌单">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                        </Button>
                    </Grid>

                    <ListView x:Name="SidebarPlaylists" Grid.Row="4" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="SidebarPlaylist_ItemClick" ItemContainerStyle="{StaticResource SidebarItemStyle}"
                              Background="Transparent" Padding="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="34" Padding="10,0" Background="Transparent" ToolTipService.ToolTip="{Binding Name}" Loaded="SidebarPlaylist_Loaded">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{ThemeResource TextDimBrush}"
                                               Margin="9,0,6,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="10" Foreground="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="5" Spacing="8">
                    <Button x:Name="UserButton" Style="{StaticResource NavButtonStyle}" Height="56"
                            Click="UserButton_Click" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource AccentSoftBrush}" HorizontalAlignment="Left">
                                <TextBlock x:Name="UserInitial" Text="♪" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Spacing="1">
                                <TextBlock x:Name="UserName" Text="登录 / 注册" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="UserRole" Text="同步歌单与收藏" FontSize="10.5" Foreground="{ThemeResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="SidebarToggle" Style="{StaticResource FlatIconButtonStyle}" Width="40" Height="32" HorizontalAlignment="Left" Click="SidebarToggle_Click" ToolTipService.ToolTip="收起导航栏" AutomationProperties.Name="收起导航栏">
                        <FontIcon x:Name="SidebarToggleIcon" Glyph="&#xE76B;" FontSize="16" />
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容 -->
            <Frame x:Name="ContentFrame" Grid.Column="1" Background="Transparent" Navigated="ContentFrame_Navigated" />
        </Grid>

        <!-- ================= 播放条 ================= -->
        <Border x:Name="PlayerBarSurface" Grid.Row="2" Tapped="PlayerBar_Tapped" Background="{ThemeResource PlayerBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="24,12" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="240" />
                    <ColumnDefinition Width="4*" MinWidth="320" />
                    <ColumnDefinition Width="3*" MinWidth="180" />
                </Grid.ColumnDefinitions>

                <!-- 当前歌曲 -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Width="56" Height="56" RadiusX="8" RadiusY="8" VerticalAlignment="Center"
                               Fill="{Binding Player.CoverUrl, Converter={StaticResource CoverBrush}}"
                               Tapped="PlayerInfo_Tapped" ToolTipService.ToolTip="展开歌词"
                               AutomationProperties.Name="展开歌词" />
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" RowSpacing="4">
                        <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="28" /></Grid.RowDefinitions>
                        <Grid Background="Transparent" Tapped="PlayerInfo_Tapped" ToolTipService.ToolTip="展开歌词">
                            <TextBlock x:Name="PlayerTitleInfo" FontSize="13" Foreground="{ThemeResource TextBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Player.Title}" FontWeight="SemiBold" />
                                <Run Text=" · " Foreground="{ThemeResource TextDimBrush}" />
                                <Run Text="{Binding Player.Singer}" Foreground="{ThemeResource TextDimBrush}" />
                            </TextBlock>
                            <TextBlock x:Name="PlayerLyricLine" FontSize="13" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Width="28" Height="28" Click="PlayerFavorite_Click" ToolTipService.ToolTip="喜欢" AutomationProperties.Name="喜欢">
                                <FontIcon x:Name="PlayerHeartIcon" Glyph="&#xEB51;" FontSize="17" />
                            </Button>
                            <TextBlock Text="{Binding Player.ErrorMessage}" FontSize="11" Foreground="{ThemeResource PinkBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200"
                                       VerticalAlignment="Center" Visibility="{Binding Player.ErrorMessage, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 控制与进度 -->
                <Grid Grid.Column="1" MaxWidth="520" VerticalAlignment="Center" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" VerticalAlignment="Center">
                            <Button x:Name="ShuffleButton" Style="{StaticResource PlayerIconButtonStyle}" Click="Repeat_Click" ToolTipService.ToolTip="{Binding Player.RepeatText}" AutomationProperties.Name="{Binding Player.RepeatText}">
                                <FontIcon Glyph="{Binding Player.RepeatGlyph}" FontSize="16" Foreground="{Binding Player.RepeatActive, Converter={StaticResource BoolToActiveBrush}}" />
                            </Button>
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Prev_Click" ToolTipService.ToolTip="上一首">
                                <FontIcon Glyph="&#xE892;" FontSize="18" />
                            </Button>
                            <Button x:Name="PlayerPlayButton" AutomationProperties.AutomationId="PlayerPlayButton" AutomationProperties.Name="播放/暂停"
                                    Style="{StaticResource PlayCircleButtonStyle}" Click="PlayPause_Click" ToolTipService.ToolTip="播放/暂停">
                                <FontIcon Glyph="{Binding Player.PlayGlyph}" FontSize="18" Foreground="{ThemeResource PrimaryTextBrush}" />
                            </Button>
                            <Button Style="{StaticResource PlayerIconButtonStyle}" Click="Next_Click" ToolTipService.ToolTip="下一首">
                                <FontIcon Glyph="&#xE893;" FontSize="18" />
                            </Button>
                            <Button x:Name="MuteButton" Style="{StaticResource PlayerIconButtonStyle}" ToolTipService.ToolTip="音量" AutomationProperties.Name="音量">
                                <FontIcon Glyph="{Binding Player.VolumeGlyph}" FontSize="19" />
                                <Button.Flyout>
                                    <Flyout x:Name="VolumeFlyout" Placement="Top" Opened="VolumeFlyout_Opened" Closed="VolumeFlyout_Closed">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Background" Value="{ThemeResource PlayerBrush}" />
                                                <Setter Property="BorderBrush" Value="{ThemeResource LineBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="12" />
                                                <Setter Property="Padding" Value="12,16,12,4" />
                                                <Setter Property="MinWidth" Value="0" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <StackPanel x:Name="VolumeFlyoutContent" Width="64" Spacing="8">
                                            <Slider x:Name="VolumeSlider" Orientation="Vertical" Width="32" Height="160" HorizontalAlignment="Center"
                                                    Minimum="0" Maximum="1" StepFrequency="0.01" ValueChanged="VolumeSlider_ValueChanged"
                                                    IsThumbToolTipEnabled="False" AutomationProperties.Name="音量" />
                                            <TextBlock x:Name="VolumePercentText" Text="75%" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextBrush}" HorizontalAlignment="Center" />
                                            <Border BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,1,0,0" Margin="-12,4,-12,0" Padding="0,4,0,0">
                                                <Button x:Name="VolumeMuteButton" Style="{StaticResource PlayerIconButtonStyle}" Width="88" Height="36"
                                                        Click="ToggleMute_Click" ToolTipService.ToolTip="静音" AutomationProperties.Name="静音">
                                                    <FontIcon Glyph="{Binding Player.VolumeGlyph}" FontSize="19" />
                                                </Button>
                                            </Border>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Player.PositionText}" FontSize="10.5" Foreground="{ThemeResource TextFaintBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="ProgressSlider" Grid.Column="1" Height="28" Minimum="0" Maximum="1" StepFrequency="0.01"
                                ValueChanged="ProgressSlider_ValueChanged" Tapped="ProgressSlider_Tapped" IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Player.DurationText}" FontSize="10.5" Foreground="{ThemeResource TextFaintBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- 右侧操作 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="QualityButton" Style="{StaticResource GhostButtonStyle}" Height="28" Padding="10,0" Click="Quality_Click" ToolTipService.ToolTip="{Binding Player.QualityDescription}">
                        <TextBlock Text="{Binding Player.QualityLabel}" FontSize="11" />
                    </Button>
                    <Button x:Name="LyricsButton" AutomationProperties.AutomationId="LyricsButton" AutomationProperties.Name="桌面歌词"
                            Style="{StaticResource GhostButtonStyle}" Height="28" Padding="10,0" Click="DesktopLyrics_Click" RightTapped="DesktopLyrics_RightTapped" ToolTipService.ToolTip="桌面歌词">
                        <TextBlock Text="词" FontSize="12" FontWeight="SemiBold" />
                    </Button>
                    <Button x:Name="QueueButton" Style="{StaticResource PlayerIconButtonStyle}" Click="Queue_Click" ToolTipService.ToolTip="播放队列">
                        <FontIcon Glyph="&#xE8FD;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 全屏播放 ================= -->
        <Grid x:Name="NowPlayingOverlay" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource AppBgBrush}">
            <Grid.RenderTransform><TranslateTransform x:Name="NowPlayingTranslate" /></Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="NowPlayingHeader" Grid.Row="0" Padding="28,16,28,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="NowPlayingBackButton" Style="{StaticResource FlatIconButtonStyle}" Width="32" Height="32"
                            Click="CloseNowPlaying_Click" ToolTipService.ToolTip="返回" AutomationProperties.Name="返回">
                        <FontIcon Glyph="&#xE72B;" FontSize="17" Foreground="{ThemeResource TextBrush}" />
                    </Button>
                    <TextBlock Text="正在播放" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFaintBrush}" CharacterSpacing="160" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid x:Name="NowPlayingBody" Grid.Row="1" Padding="48,24" ColumnSpacing="72" MaxWidth="1160" HorizontalAlignment="Center" SizeChanged="NowPlayingBody_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="FullCover" Width="360" Height="360" CornerRadius="12" VerticalAlignment="Center">
                    <Rectangle RadiusX="12" RadiusY="12" Fill="{Binding Player.CoverUrl, Converter={StaticResource CoverBrush}}" />
                </Border>
                <Grid Grid.Column="1" MaxHeight="480" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8" Margin="8,0,8,20">
                        <TextBlock Text="{Binding Player.Title}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Player.Singer}" FontSize="15" Foreground="{ThemeResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ListView Grid.Row="1" x:Name="LyricsList" Background="Transparent" SelectionMode="None"
                              IsItemClickEnabled="True" ItemClick="Lyric_ItemClick" ItemContainerStyle="{StaticResource LyricItemStyle}"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden" Padding="0,56,0,100">
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Text}" FontSize="20"
                                                   FontWeight="{Binding IsActive, Converter={StaticResource LyricWeight}}"
                                                   Foreground="{ThemeResource TextBrush}" Opacity="{Binding IsActive, Converter={StaticResource BoolToOpacity}}" TextWrapping="Wrap" LineHeight="32" />
                                        <TextBlock Text="{Binding Translation}" FontSize="12" Foreground="{ThemeResource TextFaintBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding Translation, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoLyricsText" Text="暂无歌词" FontSize="14" Foreground="{ThemeResource TextFaintBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Grid>


        </Grid>

        <!-- ================= 播放队列 ================= -->
        <Grid x:Name="QueueOverlay" Grid.Row="1" Visibility="Collapsed">
            <Rectangle Fill="#66000000" />
            <Border Width="400" HorizontalAlignment="Right" Background="{ThemeResource PlayerBrush}"
                    BorderBrush="{ThemeResource LineBrush}" BorderThickness="1,0,0,0">
                <Grid Padding="16,14,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="播放队列" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Name="QueueCountText" Text="" FontSize="11" Foreground="{ThemeResource TextFaintBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" Height="26" Padding="9,0" Click="QueueClear_Click">
                                <TextBlock Text="清空" FontSize="11" />
                            </Button>
                            <Button Style="{StaticResource FlatIconButtonStyle}" Width="26" Height="26" Click="CloseQueue_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="QueueEmptyText" Grid.Row="1" Text="播放队列是空的" FontSize="12" Foreground="{ThemeResource TextFaintBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Queue_ItemClick"
                              ItemContainerStyle="{StaticResource PlainListViewItemStyle}" Background="Transparent" Padding="0,8,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="50" Background="Transparent" Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{ThemeResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SingerText}" FontSize="11" Foreground="{ThemeResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource FlatIconButtonStyle}" Width="26" Height="26" Click="QueueRemove_Click" ToolTipService.ToolTip="移出队列">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 启动占位 ================= -->
        <Grid x:Name="BootSplash" Grid.RowSpan="3" Background="{ThemeResource AppBgBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Image Source="Assets/app.png" Width="78" Height="78" />
                <TextBlock Text="觅音" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TextBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="MIYIN MUSIC" FontSize="10" CharacterSpacing="220" Foreground="{ThemeResource TextFaintBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ================= 提示 ================= -->
        <Grid Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,56,0,0" IsHitTestVisible="False">
            <InfoBar x:Name="ToastBar" IsOpen="False" Severity="Informational" MinWidth="300" MaxWidth="520" />
        </Grid>
    </Grid>
</Window>

