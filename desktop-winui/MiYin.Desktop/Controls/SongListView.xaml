<UserControl
    x:Class="MiYin.Desktop.Controls.SongListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiYin.Desktop.Controls"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="RowActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatIconButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="30" Padding="8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="116" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="#" FontSize="11" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="歌曲" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="专辑" FontSize="11" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="音质" FontSize="11" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="时长" FontSize="11" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <ItemsControl x:Name="Items" Grid.Row="1">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="controls:SongRow">
                    <Grid Height="54" Padding="8,0" Background="Transparent" AutomationProperties.Name="{x:Bind Name}"
                          PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited"
                          DoubleTapped="Row_DoubleTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="116" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Bind IndexText}" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <Grid Grid.Column="1" Width="40" Height="40">
                            <Rectangle RadiusX="8" RadiusY="8" Fill="{x:Bind CoverUrl, Converter={StaticResource CoverBrush}}" />
                            <Button Style="{StaticResource RowActionButtonStyle}" Width="40" Height="40" Background="Transparent"
                                    Click="CoverPlay_Click" ToolTipService.ToolTip="播放" AutomationProperties.Name="播放" AutomationProperties.AutomationId="SongPlayButton">
                                <FontIcon Glyph="&#xE768;" FontSize="13" Foreground="White" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="5,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind PlatformText}" FontSize="9.5" Foreground="{StaticResource TextFaintBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind Singer}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{x:Bind AlbumName}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />

                        <Border Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4" Padding="5,2"
                                Background="{x:Bind QualityText, Converter={StaticResource QualityBrush}}"
                                Visibility="{x:Bind QualityText, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="{x:Bind QualityText}" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{x:Bind QualityText, Converter={StaticResource QualityForeground}}" />
                        </Border>

                        <TextBlock Grid.Column="5" Text="{x:Bind DurationText}" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource RowActionButtonStyle}" Click="Favorite_Click" ToolTipService.ToolTip="喜欢" AutomationProperties.Name="喜欢" AutomationProperties.AutomationId="SongFavoriteButton">
                                <FontIcon Glyph="{x:Bind HeartGlyph, Mode=OneWay}" FontSize="14"
                                          Foreground="{x:Bind IsFavorite, Mode=OneWay, Converter={StaticResource BoolToActiveBrush}}" />
                            </Button>
                            <Button Style="{StaticResource RowActionButtonStyle}" Click="Add_Click" ToolTipService.ToolTip="添加到歌单" AutomationProperties.Name="添加到歌单" AutomationProperties.AutomationId="SongAddButton">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource RowActionButtonStyle}" Click="Download_Click" ToolTipService.ToolTip="下载" AutomationProperties.Name="下载" AutomationProperties.AutomationId="SongDownloadButton">
                                <FontIcon Glyph="&#xE896;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource RowActionButtonStyle}" Click="More_Click" ToolTipService.ToolTip="更多" AutomationProperties.Name="更多" AutomationProperties.AutomationId="SongMoreButton">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="下一首播放" Click="PlayNext_Click" />
                                        <MenuFlyoutItem Text="添加到播放队列" Click="QueueEnd_Click" />
                                        <MenuFlyoutItem Text="下载" Click="Download_Click" />
                                        <MenuFlyoutItem Text="复制歌名" Click="Copy_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="从歌单移除" Click="Remove_Click" Visibility="{x:Bind CanRemove, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
