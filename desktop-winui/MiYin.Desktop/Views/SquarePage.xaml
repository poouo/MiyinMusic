<Page
    x:Class="MiYin.Desktop.Views.SquarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Padding="28,16,28,10" Spacing="5">
            <Grid>
                <TextBlock Text="歌单广场" Style="{StaticResource PageTitleStyle}" />
                <ProgressRing x:Name="LoadingRing" IsActive="True" Width="24" Height="24" HorizontalAlignment="Right"
                              Foreground="{ThemeResource AccentBrush}" />
            </Grid>
            <TextBlock x:Name="SubtitleText" Text="网易云音乐与 QQ 音乐精选歌单" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="28,0,28,14">
            <ComboBox x:Name="PlatformBox" Width="180" Height="34" HorizontalAlignment="Left"
                      SelectionChanged="PlatformBox_SelectionChanged" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                <TextBlock x:Name="EmptyText" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Visibility="Collapsed" />
                <Button x:Name="LoadMoreButton" Style="{StaticResource GhostButtonStyle}" Content="加载更多歌单" Click="LoadMore_Click" />
            </StackPanel>
        </Grid>
        <GridView x:Name="PlaylistGrid" Grid.Row="2" Padding="28,0,28,8" SelectionMode="None" IsItemClickEnabled="True"
                  ItemTemplate="{StaticResource PlaylistCardTemplate}" ItemContainerStyle="{StaticResource GridCardItemStyle}"
                  ItemClick="PlaylistGrid_ItemClick" Background="Transparent" />
    </Grid>
</Page>

