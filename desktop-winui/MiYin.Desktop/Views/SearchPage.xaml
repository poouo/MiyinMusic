<Page
    x:Class="MiYin.Desktop.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiYin.Desktop.Controls"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Padding="28,16,28,12" Spacing="12">
            <Grid>
                <TextBlock Text="搜索" Style="{StaticResource PageTitleStyle}" />
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24" HorizontalAlignment="Right"
                              Foreground="{StaticResource AccentBrush}" />
            </Grid>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PlatformBox" Height="36" SelectionChanged="PlatformBox_SelectionChanged" />
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Height="36" PlaceholderText="搜索歌曲、歌手、专辑"
                                QuerySubmitted="SearchBox_QuerySubmitted" />
                <Button x:Name="SearchButton" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="搜索" Click="Search_Click" />
            </Grid>
            <TextBlock x:Name="SummaryText" Text="输入关键词开始搜索" Style="{StaticResource MutedTextStyle}" />
        </StackPanel>
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Padding="28,0,28,30" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock x:Name="EmptyText" Text="" Style="{StaticResource MutedTextStyle}" Margin="0,40,0,0"
                           HorizontalAlignment="Center" />
                <controls:SongListView x:Name="Results" />
                <Button x:Name="LoadMoreButton" Style="{StaticResource GhostButtonStyle}" Content="加载更多"
                        HorizontalAlignment="Center" Visibility="Collapsed" Click="LoadMore_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
