<Page
    x:Class="MiYin.Desktop.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MiYin.Desktop.Controls"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,18,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="150" Height="150" HorizontalAlignment="Left">
                <Rectangle x:Name="CoverRect" Width="150" Height="150" RadiusX="16" RadiusY="16" />
                <FontIcon x:Name="CoverIcon" Glyph="&#xE8D6;" FontSize="42" Foreground="White" Opacity="0.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="KindText" Text="歌单" FontSize="11" Foreground="{ThemeResource TextFaintBrush}" CharacterSpacing="40" />
                <TextBlock x:Name="TitleText" Text="" FontSize="27" FontWeight="Bold" Foreground="{ThemeResource TextBrush}"
                           TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                <TextBlock x:Name="SubtitleText" Text="" FontSize="12" Foreground="{ThemeResource TextDimBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button x:Name="PlayAllButton" Style="{StaticResource PrimaryButtonStyle}" Click="PlayAll_Click" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                            <TextBlock Text="播放全部" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RenameButton" Style="{StaticResource GhostButtonStyle}" Content="重命名" Visibility="Collapsed" Click="Rename_Click" />
                    <Button x:Name="DeleteButton" Style="{StaticResource GhostButtonStyle}" Content="删除歌单" Visibility="Collapsed" Click="Delete_Click" />
                    <Button x:Name="ClearButton" Style="{StaticResource GhostButtonStyle}" Content="清空记录" Visibility="Collapsed" Click="Clear_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Padding="28,0,28,30" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock x:Name="EmptyText" Text="" Style="{StaticResource MutedTextStyle}" Margin="0,40,0,0"
                           HorizontalAlignment="Center" Visibility="Collapsed" />
                <controls:SongListView x:Name="Songs" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

