<Page
    x:Class="MiYin.Desktop.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="28,16,28,12">
            <StackPanel Spacing="4">
                <TextBlock Text="下载管理" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText" Text="主动下载的文件永久保留，不受缓存容量限制" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButtonStyle}" Content="打开下载目录" Click="OpenFolder_Click" />
                <Button Style="{StaticResource GhostButtonStyle}" Content="清理已完成" Click="ClearCompleted_Click" />
            </StackPanel>
        </Grid>
        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Padding="28,0,28,30" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock x:Name="EmptyText" Text="还没有下载任务" Style="{StaticResource MutedTextStyle}"
                           HorizontalAlignment="Center" Margin="0,50,0,0" />
                <ItemsControl x:Name="DownloadsItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="46" Height="46" RadiusX="8" RadiusY="8" Fill="{Binding CoverUrl, Converter={StaticResource CoverBrush}}" />
                                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                            <TextBlock Text="{Binding Quality}" FontSize="10" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Singer}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Foreground="{StaticResource AccentBrush}"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                                        <TextBlock Text="{Binding Error}" FontSize="10.5" Foreground="{StaticResource PinkBrush}"
                                                   Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="取消" Height="28" Padding="10,0"
                                                Click="Cancel_Click" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="打开位置" Height="28" Padding="10,0"
                                                Click="Reveal_Click" Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
