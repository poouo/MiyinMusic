<Page
    x:Class="MiYin.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,16,28,40" Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="账号" Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="AccountNameText" Text="未登录" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="AccountRoleText" Text="登录后可同步收藏、歌单与播放记录" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="LoginButton" Style="{StaticResource GhostButtonStyle}" Content="登录 / 注册" Click="Login_Click" />
                            <Button x:Name="NicknameButton" Style="{StaticResource GhostButtonStyle}" Content="修改昵称" Click="Nickname_Click" Visibility="Collapsed" />
                            <Button x:Name="LogoutButton" Style="{StaticResource GhostButtonStyle}" Content="退出登录" Click="Logout_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="歌单和收藏会同步到服务器，服务端会自动缓存歌单里的歌曲。" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="窗口与托盘" Style="{StaticResource SectionTitleStyle}" />
                    <ToggleSwitch x:Name="CloseToTraySwitch" Header="关闭窗口时隐藏到托盘" OnContent="开启" OffContent="关闭"
                                  Toggled="CloseToTray_Toggled" />
                    <ToggleSwitch x:Name="MinimizeToTraySwitch" Header="最小化时隐藏到托盘" OnContent="开启" OffContent="关闭"
                                  Toggled="MinimizeToTray_Toggled" />
                    <TextBlock Text="托盘图标：左键恢复窗口，右键菜单支持播放 / 暂停、上一首、下一首和退出。若图标被 Windows 折叠，请点任务栏的 ^ 展开。"
                               Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="播放" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="优先音质" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="QualityBox" Grid.Column="1" Width="220" Height="34" HorizontalAlignment="Left"
                                  SelectionChanged="QualityBox_SelectionChanged" />
                    </Grid>
                    <TextBlock Text="播放时优先向音源请求该音质，不支持时自动降级。" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="本地缓存" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="播放时自动缓存音频，下次优先从本地播放；超出容量按最久未播放清理。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CachePathBox" Height="34" FontSize="12" IsReadOnly="True" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="选择目录" Click="CacheBrowse_Click" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="打开目录" Click="CacheOpen_Click" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="缓存上限" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CacheSizeBox" Grid.Column="1" Width="140" Height="34" HorizontalAlignment="Left"
                                  SelectionChanged="CacheSize_SelectionChanged" />
                        <ToggleSwitch x:Name="AutoCacheSwitch" Grid.Column="2" Header="播放时自动缓存" OnContent="开启" OffContent="关闭"
                                      Toggled="AutoCache_Toggled" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock x:Name="CacheUsageText" Style="{StaticResource MutedTextStyle}" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="清空本地缓存" Click="CacheClear_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="下载" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="主动下载的文件保存在下面目录，永久保留，不计入缓存上限。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadPathBox" Height="34" FontSize="12" IsReadOnly="True" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="选择目录" Click="DownloadBrowse_Click" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="打开目录" Click="DownloadOpen_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Button x:Name="AdminButton" Style="{StaticResource GhostButtonStyle}" Content="打开服务端管理后台" Click="Admin_Click" Visibility="Collapsed" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
