<Page
    x:Class="MiYin.Desktop.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,16,28,40" Spacing="16" HorizontalAlignment="Stretch">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="本地音乐" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="扫描所选文件夹及子目录中的音频，读取标题、歌手、专辑。每次最多 5000 首。" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ScanMusicButton" Content="扫描音乐目录" Click="ScanMusic_Click" />
                        <Button Content="打开本地音乐" Click="OpenLocalMusic_Click" />
                        <Button Content="清空索引" Click="ClearLocalMusic_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主题" FontSize="13" Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="220" SelectionChanged="ThemeBox_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="账号" Style="{StaticResource SectionTitleStyle}" />
                    <Button Content="导入公开歌单" Click="ImportPlaylist_Click" HorizontalAlignment="Left" />
                    <ComboBox x:Name="FollowingBox" Header="关注的歌手" DisplayMemberPath="Name" Width="260" />
                    <Button Content="查看歌手作品" Click="OpenFollowing_Click" HorizontalAlignment="Left" />
                    <Grid>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="AccountNameText" Text="未登录" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <TextBlock x:Name="AccountRoleText" Text="登录后可同步收藏、歌单与播放记录" Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="LoginButton" Style="{StaticResource GhostButtonStyle}" Content="登录 / 注册" Click="Login_Click" />
                            <Button x:Name="NicknameButton" Style="{StaticResource GhostButtonStyle}" Content="修改昵称" Click="Nickname_Click" Visibility="Collapsed" />
                            <Button x:Name="LogoutButton" Style="{StaticResource GhostButtonStyle}" Content="退出登录" Click="Logout_Click" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="窗口与托盘" Style="{StaticResource SectionTitleStyle}" />
                    <ToggleSwitch x:Name="CloseToTraySwitch" Header="关闭窗口时隐藏到托盘" OnContent="开启" OffContent="关闭"
                                  Toggled="CloseToTray_Toggled" />
                    <ToggleSwitch x:Name="MinimizeToTraySwitch" Header="最小化时隐藏到托盘" OnContent="开启" OffContent="关闭"
                                  Toggled="MinimizeToTray_Toggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="桌面歌词" Style="{StaticResource SectionTitleStyle}" />
                    <ToggleSwitch x:Name="DesktopLyricsSwitch" Header="在桌面置顶显示歌词" OnContent="开启" OffContent="关闭" Toggled="Lyrics_Changed" />
                    <ComboBox x:Name="LyricStyleBox" Header="歌词样式" Width="240" SelectionChanged="Lyrics_SelectionChanged">
                        <ComboBoxItem Content="翡翠流光 · 绿金渐变" Tag="emerald" />
                        <ComboBoxItem Content="晴空 · 蓝紫渐变" Tag="sky" />
                        <ComboBoxItem Content="落霞 · 粉金渐变" Tag="rose" />
                        <ComboBoxItem Content="经典 · 白色描边" Tag="classic" />
                        <ComboBoxItem Content="柔白" Tag="glass" />
                    </ComboBox>
                    <Slider x:Name="LyricSizeSlider" Header="歌词字号" Minimum="24" Maximum="60" StepFrequency="2" ValueChanged="LyricsSize_Changed" Width="300" HorizontalAlignment="Left" />
                    <ToggleSwitch x:Name="LyricDoubleSwitch" Header="双行显示" OnContent="开启" OffContent="关闭" Toggled="Lyrics_Changed" />
                    <ToggleSwitch x:Name="LyricLockSwitch" Header="锁定位置" OnContent="已锁定" OffContent="未锁定" Toggled="Lyrics_Changed" />
                    <Button Content="重置歌词位置" Click="ResetLyrics_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="播放" Style="{StaticResource SectionTitleStyle}" />
                    <ComboBox x:Name="SleepBox" Header="睡眠定时" SelectionChanged="Sleep_Changed" Width="260">
                        <ComboBoxItem Content="关闭" Tag="0"/><ComboBoxItem Content="15 分钟" Tag="15"/><ComboBoxItem Content="30 分钟" Tag="30"/><ComboBoxItem Content="60 分钟" Tag="60"/><ComboBoxItem Content="播完本曲停止" Tag="-1"/>
                    </ComboBox>
                    <NumberBox x:Name="OffsetBox" Header="歌词偏移秒数（正值提前）" Minimum="-10" Maximum="10" SmallChange="0.5" ValueChanged="Offset_Changed" Width="260" HorizontalAlignment="Left" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="优先音质" FontSize="12.5" Foreground="{ThemeResource TextDimBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="QualityBox" Grid.Column="1" Width="220" Height="34" HorizontalAlignment="Left"
                                  SelectionChanged="QualityBox_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="本地缓存" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="播放时自动缓存音频，下次优先从本地播放；超出容量按最久未播放清理。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CachePathBox" Height="34" FontSize="12" IsReadOnly="True" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="选择目录" Click="CacheBrowse_Click" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="打开目录" Click="CacheOpen_Click" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="缓存上限" FontSize="12.5" Foreground="{ThemeResource TextDimBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="CacheSizeBox" Grid.Column="1" Width="140" Height="34" HorizontalAlignment="Left"
                                  SelectionChanged="CacheSize_SelectionChanged" />
                        <ToggleSwitch x:Name="AutoCacheSwitch" Grid.Column="2" Header="播放时自动缓存" OnContent="开启" OffContent="关闭"
                                      Toggled="AutoCache_Toggled" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock x:Name="CacheUsageText" Style="{StaticResource MutedTextStyle}" />
                    <Button Style="{StaticResource GhostButtonStyle}" Content="清空本地缓存" Click="CacheClear_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="下载" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="主动下载的文件保存在下面目录，永久保留，不计入缓存上限。" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadPathBox" Height="34" FontSize="12" IsReadOnly="True" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="选择目录" Click="DownloadBrowse_Click" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Content="打开目录" Click="DownloadOpen_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Button x:Name="AdminButton" Style="{StaticResource GhostButtonStyle}" Content="打开服务端管理后台" Click="Admin_Click" Visibility="Collapsed" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

